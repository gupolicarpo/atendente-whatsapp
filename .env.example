# --- WhatsApp (painel da Meta para desenvolvedores) ---
# Token de acesso permanente do usuário do sistema
WHATSAPP_TOKEN=
# Chave secreta do app (Configurações do app > Básico > Chave secreta)
APP_SECRET=
# Uma senha que VOCÊ inventa e repete no painel da Meta ao configurar o webhook
VERIFY_TOKEN=

# --- Provedor de IA (qualquer um compatível com a API da OpenAI) ---
# OpenRouter (centenas de modelos):  https://openrouter.ai/api/v1
# OpenAI:                            https://api.openai.com/v1
# Google Gemini:                     https://generativelanguage.googleapis.com/v1beta/openai
# DeepSeek:                          https://api.deepseek.com  (modelo deepseek-flash)
# Ollama no seu computador:          http://localhost:11434/v1
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=
# Opcional: opções extras do provedor, em JSON.
# DeepSeek: desligue o modo "pensar" (mais rápido e barato): {"thinking":{"type":"disabled"}}
AI_EXTRA_BODY=
